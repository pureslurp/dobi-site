# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...

# Price IDs (Dashboard → Products → your SSD product → Pricing → Price ID starts with price_)
STRIPE_PRICE_SSD_MAC=price_...
STRIPE_PRICE_SSD_LINUX=price_...

# Optional: canonical site URL for success/cancel redirects (recommended in production)
# SITE_URL=https://yoursite.com

# Optional: override zone amounts in cents (defaults: 800 / 1200 / 1600 / 2000)
# SHIPPING_ZONE_1_CENTS=800
# SHIPPING_ZONE_2_CENTS=1200
# SHIPPING_ZONE_3_CENTS=1600
# SHIPPING_ZONE_4_CENTS=2000
