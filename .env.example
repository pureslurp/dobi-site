# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...
# Publishable key (same mode as secret: test vs live) — used by embedded checkout on checkout.html
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Price IDs (Dashboard → Products → your SSD product → Pricing → Price ID starts with price_)
STRIPE_PRICE_SSD_MAC=price_...
STRIPE_PRICE_SSD_LINUX=price_...

# Optional: site origin only (scheme + host, no path to a page). Used for Stripe return_url.
# Do not set to https://yoursite.com/order-success.html — use https://yoursite.com (or https://www.yoursite.com).
# SITE_URL=https://yoursite.com

# Optional: Embedded Checkout branding (defaults match DoBi theme in static/style.css)
# STRIPE_CHECKOUT_DISPLAY_NAME=DoBi
# STRIPE_CHECKOUT_BACKGROUND_COLOR=#16213e
# STRIPE_CHECKOUT_BUTTON_COLOR=#53d769
# STRIPE_CHECKOUT_FONT_FAMILY=inter
# STRIPE_CHECKOUT_BORDER_STYLE=rectangular

# Optional: override zone amounts in cents (defaults: 800 / 1200 / 1600 / 2000)
# SHIPPING_ZONE_1_CENTS=800
# SHIPPING_ZONE_2_CENTS=1200
# SHIPPING_ZONE_3_CENTS=1600
# SHIPPING_ZONE_4_CENTS=2000
